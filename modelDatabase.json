{
    "Prima prova": {
        "latent_dim": 4,
        "encoder_layers": [
            20,
            15,
            10,
            8,
            4
        ],
        "decoder_layers": [
            4,
            10,
            15,
            20,
            25,
            30,
            35,
            40
        ],
        "beta_method": "sigmoid",
        "beta_value": 0.5,
        "kl_annealing_epochs": 200,
        "early_stopping": {
            "patience": 10,
            "delta": 1
        },
        "dataset": "delay15dim20_noise3,0",
        "batch_size": 32,
        "optimizer": "Adam",
        "learning_rate": 0.01,
        "scheduler": {
            "type": "ReduceLROnPlateau",
            "params": {
                "mode": "min",
                "factor": 0.1,
                "patience": 5
            }
        }
    }
}