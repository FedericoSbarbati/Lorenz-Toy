{
    "Prova15Decoder": {
        "decoder_layers": [
            5,
            10,
            15,
            20,
            30
        ],
        "latent_dim": 5,
        "early_stopping": {
            "patience": 10,
            "delta": -1
        },
        "dataset": "delay15dim20,15_noise0,0",
        "batch_size": 32,
        "optimizer": "Adam",
        "learning_rate": 0.01,
        "scheduler": {
            "type": "ReduceLROnPlateau",
            "params": {
                "mode": "min",
                "factor": 0.5,
                "patience": 10,
                "min_lr": 1e-07
            }
        },
        "Encoder": "Prova15"
    }
}